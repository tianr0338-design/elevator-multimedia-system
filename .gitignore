# ============================================================
# 基于 LVGL 的电梯多媒体系统 - 根目录 .gitignore
# 说明：lvgl8.3/ 内已自带一份 .gitignore 覆盖 *.o 等编译产物，
#       本文件负责补齐构建目录、二进制、IDE/系统临时文件。
# ============================================================

# ===================== 系统文件 =====================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===================== 编辑器 / IDE 临时文件 =====================
# 以下内容为环境相关，不需要入库
*.swp
*.swo
*~
.vscode/
.settings/
.project
.cproject
.clang-format

# ===================== 编译产物 / 构建目录 =====================
# 通用编译产物（lvgl8.3 自带 .gitignore 已覆盖其子树下的 *.o，
# 这里再兜底一层，覆盖根目录可能出现的同类文件）
*.o
*.ko
*.obj
*.elf
*.ilk
*.map
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.hex
*.pdb
*.idb
*.dSYM/
*.dep
*.d

# 构建目录
build/
lvgl8.3/build/

# 编译出的可执行 demo / 二进制产物
lvgl8.3/demo
lvgl8.3/project/bin/

# ===================== 日志 / 临时 =====================
*.log
tmp/
cache/
